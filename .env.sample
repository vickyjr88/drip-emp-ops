# Copy to .env and fill in. Never commit .env - it is gitignored, and the
# deploy pipeline never writes it. See docs/DEPLOYMENT.md.

# --- Database ---------------------------------------------------------------
# Host is the compose service name, not localhost.
DATABASE_URL=postgresql://postgres:postgres@db:5432/drip_emporium
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=drip_emporium

# --- Auth -------------------------------------------------------------------
# Required. Generate with: openssl rand -hex 32
# Without it the API signs tokens with a hardcoded dev key, so anyone could mint
# admin tokens. Compose refuses to start when it is unset.
JWT_SECRET=

# --- API URL ----------------------------------------------------------------
# Public URL of the backend. Next.js inlines this at BUILD time, so changing it
# requires rebuilding the web image, and setting it only at runtime has no
# effect on the browser bundle.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3101
# Used by server-rendered pages, which run inside the web container where
# localhost is the web app itself rather than the API. Read at runtime.
INTERNAL_API_BASE_URL=http://backend:3100

# --- Public site URL --------------------------------------------------------
# The origin visitors reach the site on, with scheme and no trailing slash.
# Canonical URLs, Open Graph tags, sitemap.xml and robots.txt are all absolute
# and built from this, so on a real deploy it must be the live domain
# (https://yourdomain.com). Leaving it at the localhost default in production
# points every canonical at localhost, which de-indexes the site.
# Inlined at BUILD time like NEXT_PUBLIC_API_BASE_URL: changing it needs a
# rebuild of the web image, not just a restart.
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Read by the backend for anything the customer's browser must follow: the
# Paystack callback and password-reset links. Defaults to NEXT_PUBLIC_SITE_URL,
# which is almost always right; set it separately only if the API should send
# people somewhere other than the public site.
STOREFRONT_ORIGIN=

# --- Object storage (MinIO) -------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=project-media
# Public base URL uploaded media is served from. Wrong value => broken images.
#
# Images are streamed by the backend at /media/:key, not straight from MinIO,
# so this is the API's address as a *browser* sees it -- the published port,
# not the in-network one. It must match NEXT_PUBLIC_API_BASE_URL above; when
# they disagree, uploads succeed and every link they produce is dead.
#
# In production, the public API origin, e.g. https://api.dripemporium.store
MEDIA_PUBLIC_BASE_URL=http://localhost:3101

# --- Seeded admin -----------------------------------------------------------
# Change the password before the first real deploy.
ADMIN_SEED_EMAIL=admin@dripemporium.store
ADMIN_SEED_PASSWORD=Admin@123

# --- Transactional email ------------------------------------------------------
# Which provider sends: "smtp", "brevo" or "billionmail". Left blank, every send
# tries smtp first, then brevo, then billionmail, moving to the next only if the
# one before it fails to deliver -- set this only to force a single provider and
# disable that fallback (e.g. locking to brevo during SMTP maintenance). Leaving
# every key blank skips sends; mail is still recorded as FAILED rather than
# throwing, so nothing breaks locally.
EMAIL_PROVIDER=

# Who owner-facing alerts go to (cart abandoned, order paid, new signup, contact
# form) -- also the intended destination for a future daily operations report.
OWNER_EMAIL=emporiumdrip@gmail.com

BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@dripemporium.store
BREVO_SENDER_NAME=Drip Emporium

# SMTP, via nodemailer. Usually the best choice: subject and body go straight
# into the message, with no template to configure anywhere else.
SMTP_HOST=
# 587 for STARTTLS, 465 for implicit TLS.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Drip Emporium
# Leave unset to require a valid certificate. Set to false only if your mail
# server presents a self-signed one -- BillionMail ships a stock
# *.billionmail.com certificate that matches no real domain. Mail stays
# encrypted either way, but an unverified server can be impersonated, and
# password-reset links travel over this connection.
SMTP_REJECT_UNAUTHORIZED=

# BillionMail is self-hosted, so BASE_URL is your own server (no trailing
# slash), e.g. https://webmail.dripemporium.store. The key alone is not enough
# -- there is no hosted endpoint.
#
# The key comes from the API entry you create in the BillionMail dashboard, not
# from your account or mailbox. A key that has not been issued there, or one
# whose IP whitelist excludes this server, is rejected with code 1001
# "API key is invalid".
#
# Its send API carries no subject or body: both live in a template chosen when
# the API key is created. The template must therefore render our values, or
# mail will arrive blank:
#   Subject:  {{.API.subject}}
#   Body:     {{.API.html_body}}   -- as raw HTML, not escaped
BILLIONMAIL_API_KEY=
BILLIONMAIL_BASE_URL=
# Sender address. Must be a mailbox that exists on the BillionMail server with
# a password -- naming one that does not fails the send with code 1005
# ("password not found"). Note noreply@ rather than no-reply@: they are
# different addresses and only the one you created works.
# Leave blank to use whatever sender the API entry is configured with.
BILLIONMAIL_SENDER_EMAIL=noreply@dripemporium.store
# Receives inquiries with no project principal agent (or no project at all).
INQUIRY_FALLBACK_EMAIL=admin@dripemporium.store

# Redis, backing the BullMQ reminder queues.
REDIS_URL=redis://redis:6379

# --- Africa's Talking (reminder SMS) ---
# Blank key => SMS is skipped and logged, not sent.
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=

# --- Reminder engine ---
REMINDERS_ENABLED=true
REMINDERS_CRON=0 8 * * *
REMINDERS_TIMEZONE=Africa/Nairobi

# --- Abandoned-cart reminder ---
# Set to false on a replica that must not run the worker, to avoid double-sends.
CART_REMINDERS_ENABLED=true
# Hours after a cart is first recorded abandoned before the "come back and buy"
# email goes out. Needs REDIS_URL -- there is no correct way to send this on
# time without a delayed queue, so it is skipped (and logged) without one.
CART_REMINDER_DELAY_HOURS=24

# --- Backups ----------------------------------------------------------------
# Both data volumes are driver: local, so they live only on this VPS's disk.
# scripts/backup.sh pushes the database dump and the MinIO objects to a second
# machine nightly; it refuses to run without a destination, because a backup
# that stays on the box it is protecting is not a backup. See docs/BACKUP.md.
#
# NOTE: .env itself is deliberately NOT in the backups -- it holds the JWT
# secret and database password. Keep a copy in a password manager, or a
# restored backup is unusable.
BACKUP_SSH_HOST=backupuser@backup.example.com
BACKUP_SSH_PORT=22
BACKUP_REMOTE_DIR=/srv/dripemporium-backups
# Optional: path to the private key, if not the SSH default.
BACKUP_SSH_KEY=
# Retention, in number of copies kept per tier.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# Restores every dump into a scratch Postgres to prove it is loadable. Leave on
# unless a slow host makes the nightly run take too long.
BACKUP_VERIFY=true

# --- Published host ports ---------------------------------------------------
# Defaults are deliberately off the common ones so this stack can run beside
# another compose project on the same machine. Change them here rather than in
# docker-compose.yml; MINIO_PORT above is the in-network port and is separate.
WEB_PORT=3003
API_PORT=3101
DB_PORT=15433
REDIS_PORT=16380
MINIO_HOST_PORT=19002
MINIO_CONSOLE_HOST_PORT=19003

# Which interface each published port binds to.
#
# The three ports nginx proxies (web, API, MinIO S3) default to 0.0.0.0 because
# nginx runs in its own container: to it, 127.0.0.1 is that container rather
# than the host, so a loopback binding is unreachable from the proxy. It reaches
# them on the Docker bridge address instead (usually 172.17.0.1).
#
# The firewall is what keeps those three off the public internet -- see the
# firewall section in docs/DEPLOYMENT.md, and verify it, because Docker's
# iptables rules are consulted before the chain most firewall UIs manage.
#
# Set these to 127.0.0.1 if nginx ever runs on the host itself, where loopback
# is both reachable and stricter.
#WEB_BIND=127.0.0.1
#API_BIND=127.0.0.1
#MINIO_BIND=127.0.0.1
#
# Postgres (DB_PORT), Redis (REDIS_PORT) and the MinIO console
# (MINIO_CONSOLE_HOST_PORT) are hardcoded to 127.0.0.1 in docker-compose.yml and
# have no override: nothing proxies them, so they should never be exposed.
# Reach them over an SSH tunnel.

# --- Paystack ---------------------------------------------------------------
# Test keys start sk_test_/pk_test_. The secret never reaches the browser; the
# public key is inlined into the checkout bundle at build time.
# Webhooks are verified against the secret, so an unset key means every
# callback is rejected rather than trusted.
# Without the secret key /checkout/config reports online:false, the pay-by-card
# button is hidden and the shop falls back to WhatsApp ordering.
PAYSTACK_SECRET_KEY=
# Not used by the current redirect flow -- the server creates the transaction
# and the browser follows the URL it returns. Kept for the inline popup.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Analytics ----------------------------------------------------------------
# GA4 Measurement ID (format G-XXXXXXXXXX, from Admin -> Data Streams -> your
# web stream), not the numeric Property ID shown elsewhere in GA. Inlined at
# BUILD time like the other NEXT_PUBLIC_* values above -- changing it needs a
# rebuild, not just a restart. Left blank, no analytics script loads at all,
# which is the right default for a local or staging environment.
# Storefront only: the staff portal is excluded regardless of this value, since
# internal usage is not a marketing signal.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel ID (numeric, from Events Manager -> your pixel -> Settings).
# Same build-time/storefront-only rules as NEXT_PUBLIC_GA_MEASUREMENT_ID above.
# Powers PageView (automatic), ViewContent (product page), AddToCart (product
# page), and Purchase (order confirmation) -- see web/app/lib/meta-pixel.ts.
NEXT_PUBLIC_META_PIXEL_ID=
